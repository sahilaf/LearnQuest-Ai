# Copy to .env and adjust. NEVER commit .env.
# OWNER: Member 1. See plan.md §6.6.

# --- Model checkpoint (shipped locally, gitignored) ---
SYNCTALK_CHECKPOINT=./checkpoint/final_v2/59.pth

# --- Dataset directory ---
# Must contain BOTH full_body_img/ and landmarks/ - the server derives both from
# this one path. The reference frames are 1.27 GB, so they are NOT copied into
# this repo; we point at the existing Fydp_v2 copy instead.
#
# Moving to a GPU box? Copy that whole folder over and repoint this.
SYNCTALK_DATASET=C:/Users/sahil/Dropbox/PC/Documents/projects/Fydp_v2/SyncTalk_2D/dataset/redwan

# --- Audio feature mode: must match how the checkpoint was trained ---
SYNCTALK_MODE=ave

# --- Server ---
SYNCTALK_HOST=0.0.0.0
SYNCTALK_PORT=5001

# Longest side of streamed frames. Smaller = faster encode/send/decode. 0 = native.
SYNCTALK_OUT_SIZE=0
