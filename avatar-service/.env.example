# Copy to .env and adjust. NEVER commit .env.
# OWNER: Member 1. See plan.md §6.6.

# --- Model checkpoint (shipped locally, gitignored) ---
# Alapon: the lip-sync model trained on Redwan's recording, epoch 60. The
# train_config.json beside it tells the server which mouth mask it was trained
# with, so the two files must stay together.
SYNCTALK_CHECKPOINT=./checkpoint/alapon/59.pth

# --- Dataset directory ---
# Must contain BOTH full_body_img/ and landmarks/ - the server derives both from
# this one path. The reference frames are 1.27 GB, so they are NOT in git.
# Default: ./dataset/redwan inside avatar-service (gitignored). If your copy
# lives elsewhere (e.g. in the Fydp_v2 project), put its path in YOUR .env.
SYNCTALK_DATASET=./dataset/redwan

# --- Audio feature mode: must match how the checkpoint was trained ---
SYNCTALK_MODE=ave

# --- Server ---
# 127.0.0.1 = this machine only. The service has no login, so only use
# 0.0.0.0 when the backend runs on a different machine, on a trusted network.
SYNCTALK_HOST=127.0.0.1
SYNCTALK_PORT=5001

# Longest side of streamed frames. Smaller = faster encode/send/decode. 0 = native
# (1080p, too slow to encode at 25 fps on a laptop GPU). 720 is what Alapon ships with.
SYNCTALK_OUT_SIZE=720
