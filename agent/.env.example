# Copy to .env and fill in. NEVER commit .env.
# OWNER: Member 1. See agent/README.md.

# ---- Google Gemini (Realtime / Live API) ----
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ---- LiveKit ----
# LiveKit Cloud: wss://your-project.livekit.cloud
# Local dev:     ws://localhost:7880
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Avatar service (SyncTalk, see ../avatar-service) ----
AVATAR_BASE=http://127.0.0.1:5001
SYNCTALK_SERVER_URL=http://127.0.0.1:5001
SYNCTALK_FPS=25
SYNCTALK_START_FRAME=0

# ---- Speech ----
# Assistant audio sample rate published to the LiveKit room.
ASSISTANT_SR=24000

# Transcription language pinned on the input side. Leave empty to auto-detect,
# but note auto-detect garbled Bangla into Hindi/Roman script in testing.
#   bn-BD = Bangla   |   en-US = English
# For LearnQuest's English tutor, set this to en-US and update AGENT_INSTRUCTIONS
# in the agent file to the tutor persona (see plan.md §6.3).
INPUT_LANGUAGE=bn-BD

# Local Silero VAD for turn detection. 0 falls back to Gemini's server VAD,
# which marked 1s utterances as speech for 8-11s in testing.
LOCAL_VAD=1
