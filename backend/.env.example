# Copy to .env and fill in. NEVER commit .env.

# ---- Supabase (Member 3) ----
# Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:password@localhost:5432/learnquest

# Project Settings -> Data API -> Project URL
SUPABASE_URL=

# Project Settings -> API Keys -> JWT Secret.
# The backend verifies access tokens locally with this - no network call per request.
SUPABASE_JWT_SECRET=

# Project Settings -> API Keys -> service_role.
# Server-side only, bypasses row-level security. NEVER expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Dev escape hatch: when true, requests without a token get a fake dev user.
# MUST be false in production.
DEV_ALLOW_ANONYMOUS=true

# ---- LLM (Member 1) ----
# groq | gemini | openai | mock
# Use "mock" to run the whole app with no API key.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ---- Avatar (Member 1) ----
# Empty = Tier A (browser avatar) only, no GPU needed. This is how M2/M3/M4 should run.
# Set to the running avatar-service to enable Tier B / SyncTalk:
#   AVATAR_SERVICE_URL=http://localhost:5001
# See avatar-service/README.md.
AVATAR_SERVICE_URL=

# ---- App ----
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
