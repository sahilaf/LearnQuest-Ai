# Copy to .env and fill in. NEVER commit .env.

# ---- Database (Member 3) ----
# Supabase -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:password@localhost:5432/learnquest

# ---- Auth / Firebase (Member 3) ----
# Path to the Firebase service-account JSON. Leave empty to run without auth in dev.
FIREBASE_CREDENTIALS_JSON=
# Dev escape hatch: when true, requests without a token get a fake dev user.
# MUST be false in production.
DEV_ALLOW_ANONYMOUS=true

# ---- LLM (Member 1) ----
# groq | gemini | openai | mock
# Use "mock" to run the whole app with no API key.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ---- Avatar (Member 1) ----
# Empty = Tier A (browser avatar) only. Set to the GPU box URL to enable Tier B / SyncTalk.
AVATAR_SERVICE_URL=

# ---- App ----
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
