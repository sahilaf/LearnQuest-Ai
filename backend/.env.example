# Copy to .env and fill in. NEVER commit .env.

# ---- Supabase (Member 3) ----
# Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:password@localhost:5432/learnquest

# Project Settings -> Data API -> Project URL
SUPABASE_URL=

# Project Settings -> API Keys -> JWT Secret.
# The backend verifies access tokens locally with this - no network call per request.
SUPABASE_JWT_SECRET=

# Project Settings -> API Keys -> service_role.
# Server-side only, bypasses row-level security. NEVER expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Dev escape hatch: when true, requests without a token get a fake dev user.
# MUST be false in production.
DEV_ALLOW_ANONYMOUS=true

# ---- LLM (Member 1) ----
# groq | gemini | openai | mock
# Use "mock" to run the whole app with no API key.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ---- Avatar (Member 1) ----
# Empty = no avatar. The tutor still answers in text and Teach-Back still works;
# the tutor page shows an "avatar offline" panel. This is how M2/M3/M4 should run.
# Set to the running avatar-service to enable the SyncTalk avatar:
#   AVATAR_SERVICE_URL=http://localhost:5001
# See avatar-service/README.md.
AVATAR_SERVICE_URL=

# The avatar is audio-driven: it renders frames only in response to speech, so
# it also needs LLM_PROVIDER=gemini above. Gemini TTS returns 24 kHz PCM, which
# is exactly the rate SyncTalk works in - no resampling, and the backend refuses
# any other rate rather than desynchronising the mouth.
# Both optional; these are the defaults.
#TTS_MODEL=gemini-2.5-flash-preview-tts
#TTS_VOICE=Kore

# ---- Database tuning (optional) ----
# pool_pre_ping tests a pooled connection before every checkout. Against a
# remote pooler that is a full round trip per request (measured ~105 ms), so it
# is OFF by default and connections are recycled on age instead. Turn it back on
# if you see "server closed the connection unexpectedly".
#DB_PRE_PING=false
#DB_POOL_RECYCLE_SECONDS=240

# ---- App ----
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
