# Copy to .env and fill in. NEVER commit .env.

VITE_API_URL=http://localhost:8000

# Supabase (Member 3 shares these: Project Settings -> Data API / API Keys)
# The anon key is public by design and safe in the bundle.
# NEVER put the service_role key in this file - it bypasses row-level security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
